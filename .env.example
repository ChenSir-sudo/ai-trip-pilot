# 复制成 .env 并填入真实值：cp .env.example .env
#
# .env 已被 .gitignore 排除，永远不会入库。
# 也可以不建 .env，直接 export 同名环境变量。

# 必填。申请地址见 README。
LLM_API_KEY=

# 以下三项有默认值，通常不用改。
# 本项目默认指向 DeepSeek（OpenAI 兼容）；换供应商只改这三个变量，代码不动。
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 思考模式：true / false，默认 false。
# 结构化抽取不需要思维链，开着会更慢更贵；而思考模式下 temperature
# 等参数会静默失效（见 docs/architecture.md 的模型接入一节）。
LLM_THINKING=false

# ── 数据访问层（S2）──
#
# 用哪一份实现：local（离线快照，默认）或 amap（高德 REST，实时）。
# 默认是 local，因为它不花钱、不需要凭据——**克隆下来就该能跑**。
DATA_BACKEND=local

# 离线快照路径。用下面的命令抓一份（不入库，见 .gitignore）：
#   python -m scripts.fetch_offline_data
OFFLINE_SNAPSHOT=data/offline/places.sqlite

# 只在 DATA_BACKEND=amap 时需要。
# 注意：高德要求**实名认证**后才能建 Key（官方公告：未认证开发者将无法新增 key）。
# 建 Key 不需要企业认证。
AMAP_API_KEY=
